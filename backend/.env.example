# Database Configuration
DATABASE_URL=postgresql://mobile_store_user:mobile_store_password@localhost:5432/mobile_store_db

# JWT Secret Key (generate a secure random key for production)
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
DEBUG=True
APP_NAME="Mobile Store API"
API_VERSION="v1"

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
